        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Cambia a modo Conductor para realizar esta acción."
          },
          "code": {
            "type": "string",
            "example": "ROLE_NOT_ACTIVE"
          },
          "requiredRole": {
            "type": "string",
            "example": "Conductor"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "UP"
          },
          "message": {
            "type": "string",
            "example": "Server is healthy"
          }
        }
      },
      "AdminSummaryResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "metricas": {
