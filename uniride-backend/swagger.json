        "type": "apiKey",
        "in": "header",
        "name": "X-Active-Role",
        "description": "Encabezado opcional para alternar el rol activo del usuario (Pasajero, Conductor, Administrador)."
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Descripción clara del error."
          }
        }
      },
