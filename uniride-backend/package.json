{
  "name": "uniride-backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node scripts/db-init.js",
    "db:seed": "node scripts/db-init.js --seed",
    "db:init:test": "DB_NAME=uniride_test node scripts/db-init.js",
    "test": "jest tests/unit",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "dotenv": "^17.4.2",
    "express": "~4.16.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "~1.9.1",
    "mssql": "^12.7.0",
    "sequelize": "^6.37.8",
    "tedious": "^19.2.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0"
  }
}
